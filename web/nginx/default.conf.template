server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;

    # This checks the web server only, so the website can load during API downtime.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    # Resolve at request time and refresh addresses after backend replacements.
    resolver ${API_DNS_RESOLVERS} valid=5s;
    resolver_timeout 3s;
    set $api_upstream "${API_UPSTREAM}";

    # Only this multipart route accepts large bodies; extraction is asynchronous.
    location = /api/attachments/files {
        client_max_body_size 21m;
        client_body_timeout 30s;
        limit_req zone=document_uploads burst=8 nodelay;
        limit_req_status 429;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        proxy_buffering off;
    }

    location = /api/attachments/problem {
        client_max_body_size 1k;
        limit_req zone=document_uploads burst=8 nodelay;
        limit_req_status 429;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_next_upstream off;
    }

    location ~ "^/api/chats/[0-9a-fA-F-]{36}/attachments$" {
        client_max_body_size 21m;
        client_body_timeout 30s;
        limit_req zone=document_uploads burst=8 nodelay;
        limit_req_status 429;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_buffering off;
    }

    location ~ ^/api(?:/|$) {
        client_max_body_size 256k;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        # Allow retrieval plus the configured AI timeout.
        proxy_read_timeout 100s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        proxy_buffering off;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
