server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;

    # This checks the web server only, so the website can load during API downtime.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    # Resolve at request time and refresh addresses after backend replacements.
    resolver ${API_DNS_RESOLVERS} valid=5s;
    resolver_timeout 3s;
    set $api_upstream "${API_UPSTREAM}";

    location ~ ^/api(?:/|$) {
        client_max_body_size 128k;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        # AI requests allow 60s; do not apply the wiki's shorter proxy timeout.
        proxy_read_timeout 70s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        proxy_buffering off;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
