# Local development only. Copy to .env to override Compose defaults.
WEB_PORT=5173
# Optional web-dev Compose profile, with live reload.
VITE_PORT=5174

POSTGRES_DB=erro
POSTGRES_USER=erro
POSTGRES_PASSWORD=erro-local-postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=erro-local-redis
REDIS_PORT=6379

MINIO_ROOT_USER=erro-local
MINIO_ROOT_PASSWORD=erro-local-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENABLED=true
AWS_REGION=us-east-1

# Backend only. Add a real key to your ignored .env, never to web/ or VITE_*.
AI_API_KEY=
AI_ENDPOINT=https://api.deepseek.com/responses
AI_MODEL=deepseek-flash
# none disables thinking for basic chat; empty omits the provider parameter.
AI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT=60s
BACKEND_PORT=8080
CHAT_ALLOWED_ORIGINS=http://localhost:5173
